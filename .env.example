# =================================================================
# 🌱 EcoLoop Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Spring Boot Backend Configuration
# -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Settings (Only needed when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecoloop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=ecoloop_user
SPRING_DATASOURCE_PASSWORD=ecoloop_password

# JWT Security (Minimum 256-bit hexadecimal string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# -----------------------------------------------------------------
# 2. Frontend Configuration (Vite)
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------
# 3. Docker Compose MySQL Configuration
# -----------------------------------------------------------------
MYSQL_DATABASE=ecoloop
MYSQL_USER=ecoloop_user
MYSQL_PASSWORD=ecoloop_password
MYSQL_ROOT_PASSWORD=root_secure_password_123
